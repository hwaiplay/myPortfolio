---
interface Props {
  kind: "backend" | "database" | "frontend" | "cloud" | "tools" | "workflow";
}

const { kind } = Astro.props;
---

<span class="skill-icon" aria-hidden="true">
  {kind === "backend" && (
    <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="6" rx="2"/><rect x="4" y="14" width="16" height="6" rx="2"/><path d="M8 7h.01M8 17h.01M12 7h4M12 17h4"/></svg>
  )}
  {kind === "database" && (
    <svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v7c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 12v7c0 1.7 3.1 3 7 3s7-1.3 7-3v-7"/></svg>
  )}
  {kind === "frontend" && (
    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 22h8M12 18v4M8 9l-2 2 2 2M16 9l2 2-2 2"/></svg>
  )}
  {kind === "cloud" && (
    <svg viewBox="0 0 24 24"><path d="M7 18h11a4 4 0 0 0 .8-7.9A7 7 0 0 0 5.5 8.7 4.7 4.7 0 0 0 7 18Z"/><path d="M12 11v8M9 14l3-3 3 3"/></svg>
  )}
  {kind === "tools" && (
    <svg viewBox="0 0 24 24"><path d="M14.5 6.5a4 4 0 0 0-5-5l2.2 2.2-2.8 2.8-2.2-2.2a4 4 0 0 0 5 5L20 18a1.4 1.4 0 0 1-2 2l-8.3-8.3"/><path d="m5 14-3 3 5 5 3-3"/></svg>
  )}
  {kind === "workflow" && (
    <svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="12" cy="18" r="3"/><path d="M8.6 7.5 10.5 15M15.4 7.5 13.5 15M9 6h6"/></svg>
  )}
</span>
