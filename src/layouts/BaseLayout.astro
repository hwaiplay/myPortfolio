---
import "../styles/global.css";
import "../styles/modern.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const {
  title,
  description,
  image = "/assets/sadari-og.png"
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e9" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">본문으로 이동</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="포트폴리오 첫 화면">
        <span class="brand-copy">
          <strong>Suenghyeon Kang</strong>
          <small>Java Backend Developer</small>
        </span>
      </a>
      <nav class="site-nav" aria-label="주요 메뉴">
        <span class="nav-indicator" aria-hidden="true"></span>
        <a href="#skills" data-section-link>Skills</a>
        <a href="#experience" data-section-link>Experience</a>
        <a href="#about" data-section-link>How I Work</a>
        <a href="#sadari" data-section-link>Sadari</a>
      </nav>
      <div class="social-links" aria-label="외부 링크">
        <a class="social-link is-github" href="https://github.com/hwaiplay" target="_blank" rel="noreferrer" aria-label="GitHub 프로필 열기">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.2-3.37-1.2-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.66.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.34 9.34 0 0 1 12 6.09c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" />
          </svg>
        </a>
        <a class="social-link is-tistory" href="https://hwaiplay.tistory.com/" target="_blank" rel="noreferrer" aria-label="Tistory 블로그 열기">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="6" />
            <path d="M7.5 8h9M12 8v8" />
          </svg>
        </a>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <p class="footer-title">기술을 고른 이유까지 설명하는 개발자</p>
        <p class="footer-note">Java 백엔드 경험을 쌓으며 데이터베이스를 더 깊게 공부하고 있습니다.</p>
      </div>
      <div class="footer-links">
        <a href="https://github.com/hwaiplay" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://sadaribooks.com" target="_blank" rel="noreferrer">Sadari Live</a>
        <a href="https://docs.google.com/document/d/1xb9e4Y8-E4G5XRPo0c14EXn6K85v2oLBpG6-iMTDQ3w/edit?tab=t.0" target="_blank" rel="noreferrer">Resume</a>
      </div>
    </footer>
    <script>
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealTargets = document.querySelectorAll<HTMLElement>([
        ".hero",
        ".section-heading",
        ".metric-card",
        ".skill-card",
        ".career-card",
        ".strength-card",
        ".sadari-feature",
        ".architecture-frame",
        ".architecture-notes article",
        ".sadari-screen-copy",
        ".sadari-screen-item",
        ".data-copy",
        ".performance-card",
        ".profile-meta > div"
      ].join(", "));
      const progress = document.querySelector<HTMLElement>(".scroll-progress");
      const siteHeader = document.querySelector<HTMLElement>(".site-header");
      const siteNav = document.querySelector<HTMLElement>(".site-nav");
      const anchorLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
      const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-section-link]"));
      const trackedSections = sectionLinks
        .map((link) => document.querySelector<HTMLElement>(link.hash))
        .filter((section): section is HTMLElement => section !== null);
      let anchorScrollTarget = "";

      const setNavIndicator = (): void => {
        const activeLink = sectionLinks.find((link) => link.classList.contains("is-active"));

        if (!siteNav || !activeLink) {
          siteNav?.classList.remove("has-active");
          return;
        }

        siteNav.style.setProperty("--nav-indicator-x", `${activeLink.offsetLeft}px`);
        siteNav.style.setProperty("--nav-indicator-width", `${activeLink.offsetWidth}px`);
        siteNav.classList.add("has-active");
      };

      const setActiveSection = (sectionId: string): void => {
        sectionLinks.forEach((link) => {
          const isActive = link.hash === `#${sectionId}`;
          link.classList.toggle("is-active", isActive);

          if (isActive) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });

        setNavIndicator();
      };

      const syncActiveSection = (): void => {
        if (anchorScrollTarget) {
          setActiveSection(anchorScrollTarget);
          return;
        }

        const activationLine = window.scrollY + (siteHeader?.offsetHeight ?? 0) + 1;
        let activeSectionId = "";

        trackedSections.forEach((section) => {
          if (section.offsetTop <= activationLine) {
            activeSectionId = section.id;
          }
        });

        setActiveSection(activeSectionId);
      };

      const scrollToAnchor = (hash: string, smooth: boolean): void => {
        const target = document.querySelector<HTMLElement>(hash);

        if (!target) {
          return;
        }

        const headerHeight = siteHeader?.offsetHeight ?? 0;
        const targetTop = target.getBoundingClientRect().top + window.scrollY - headerHeight;
        window.scrollTo({
          top: Math.max(0, targetTop),
          behavior: smooth && !reducedMotion ? "smooth" : "auto"
        });
      };

      const setProgress = (): void => {
        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
        const percentage = scrollableHeight > 0 ? (window.scrollY / scrollableHeight) * 100 : 0;

        if (progress) {
          progress.style.width = `${percentage}%`;
        }
      };

      if (reducedMotion) {
        revealTargets.forEach((target) => target.classList.add("is-visible"));
      } else {
        document.documentElement.classList.add("motion-ready");

        revealTargets.forEach((target) => target.classList.add("reveal-item"));
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: "0px 0px -9% 0px" });

        revealTargets.forEach((target) => revealObserver.observe(target));
      }

      anchorLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          anchorScrollTarget = link.hash.slice(1);
          setActiveSection(anchorScrollTarget);

          if (window.location.hash === link.hash) {
            window.history.replaceState(null, "", link.hash);
          } else {
            window.history.pushState(null, "", link.hash);
          }

          scrollToAnchor(link.hash, true);
        });
      });

      window.addEventListener("scrollend", () => {
        const completedHash = anchorScrollTarget ? `#${anchorScrollTarget}` : "";
        anchorScrollTarget = "";

        if (completedHash) {
          scrollToAnchor(completedHash, false);
        }

        syncActiveSection();
      });
      window.addEventListener("popstate", () => scrollToAnchor(window.location.hash, false));
      window.addEventListener("resize", setNavIndicator);
      window.addEventListener("scroll", setProgress, { passive: true });
      window.addEventListener("scroll", syncActiveSection, { passive: true });
      setProgress();
      syncActiveSection();

      if (window.location.hash) {
        window.requestAnimationFrame(() => scrollToAnchor(window.location.hash, false));
      }
    </script>
  </body>
</html>
